# Comma-separated list of allowed frontend origins (no trailing slash).
# Local defaults are fine for npm run dev.
# Production: add your Vercel URL(s).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://YOUR-APP.vercel.app

# Host/port used by local uvicorn / Docker
HOST=0.0.0.0
PORT=8000
